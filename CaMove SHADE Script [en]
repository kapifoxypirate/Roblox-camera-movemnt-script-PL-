-- 🔧 Configuration
local Config = {
    sensitivity = 0.5,               -- Sensitivity of mouse movement
    snap = math.rad(85),             -- Snap limit for vertical camera movement
    offsetClose = Vector3.new(2, 2, 8),  -- Camera offset when close
    offsetFar = Vector3.new(2, 2, 14),   -- Camera offset when far
    smoothness = 0.5,                -- Smoothness of the camera movement
    initialFov = 70,                 -- Initial Field of View (FOV)
    fovSpeed = 5,                    -- Speed of FOV change
    blurIntensity = 5,               -- Intensity of the blur effect
    transitionSpeed = 0.1,           -- Speed of smooth camera transition
    headBobAmount = 0.2,             -- Amount of head bobbing
    headBobSpeed = 6,                -- Speed of head bobbing
    breathAmount = 0.05,             -- Breathing amount effect
    breathSpeed = 2,                 -- Speed of breathing effect
    soundSensitivity = 5,            -- Sensitivity of camera zoom sound
}

-- 🔌 Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")

-- 📷 Player and Camera
local Player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- 🧠 State Variables
local Character, Root
local moveX, moveY, targetX, targetY = 0, 0, 0, 0
local isMouseLocked, isDragging, isZooming = true, false, false
local currentFov, targetFov = Config.initialFov, Config.initialFov
local currentOffset, targetOffset = Config.offsetClose, Config.offsetClose
local currentFovChange = Config.initialFov
local bobOffset, headBobTime = Vector3.zero, 0
local breathOffset = 0
local blurEffect

-- 🔊 Camera zoom sound
local cameraSfx = Instance.new("Sound")
cameraSfx.SoundId = "rbxassetid://9118771206"  -- "Shuffling" sound effect
cameraSfx.Looped = false
cameraSfx.Volume = 0.3
cameraSfx.Name = "CameraZoomSfx"
cameraSfx.Parent = SoundService

-- 📌 Toggle mouse lock function
local function toggleMouseLock()
    UserInputService.MouseBehavior = isMouseLocked and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
    UserInputService.MouseIconEnabled = not isMouseLocked
end

-- 🔁 Update character data
local function updateCharacter()
    Character = Player.Character or Player.CharacterAdded:Wait()
    Root = Character:WaitForChild("HumanoidRootPart")
end
updateCharacter()
Player.CharacterAdded:Connect(updateCharacter)

-- 📦 Blur effect setup
local function setupBlurEffect()
    blurEffect = Instance.new("BlurEffect")
    blurEffect.Size = 0
    blurEffect.Parent = Lighting
end
setupBlurEffect()

-- 🎥 Mouse movement function
local function mouseMove(_, _, input)
    if isMouseLocked or (UserInputService.MouseIconEnabled and isDragging) then
        targetX -= input.Delta.x * Config.sensitivity / 100
        targetY -= input.Delta.y * Config.sensitivity / 100
        targetY = math.clamp(targetY, -Config.snap, Config.snap)
    end
end
ContextActionService:BindActionToInputTypes("MouseMove", mouseMove, false, Enum.UserInputType.MouseMovement)

-- 🖱️ Input events
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.E then
        isMouseLocked = not isMouseLocked
        toggleMouseLock()

    elseif input.KeyCode == Enum.KeyCode.V then
        isZooming = not isZooming
        targetOffset = isZooming and Config.offsetFar or Config.offsetClose

        -- Play sound when changing perspective
        if not cameraSfx.IsPlaying then
            cameraSfx:Play()
        end

    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        isDragging = true
        if not isMouseLocked then
            UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isDragging = false
        if not isMouseLocked then
            UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        end
    end
end)

-- 🌬️ Head bobbing effect
local function updateHeadBob(deltaTime)
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    local velocity = Root.Velocity
    local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude

    if speed > 1 and humanoid and humanoid.MoveDirection.Magnitude > 0 then
        headBobTime += deltaTime * Config.headBobSpeed
        local x = math.sin(headBobTime) * Config.headBobAmount
        local y = math.abs(math.cos(headBobTime)) * Config.headBobAmount
        bobOffset = bobOffset:Lerp(Vector3.new(x, y, 0), 0.1)
    else
        bobOffset = bobOffset:Lerp(Vector3.zero, 0.1)
    end
end

-- 😮 Breathing effect
local function updateBreath()
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    local speed = Vector3.new(Root.Velocity.X, 0, Root.Velocity.Z).Magnitude

    if speed < 0.1 and humanoid and humanoid.MoveDirection.Magnitude == 0 then
        breathOffset = math.sin(tick() * Config.breathSpeed) * Config.breathAmount
    else
        breathOffset = 0
    end
end

-- 🔍 Zoom and Field of View (FOV) update
local function updateZoom()
    local humanoid = Character:FindFirstChildOfClass("Humanoid")
    local speed = Vector3.new(Root.Velocity.X, 0, Root.Velocity.Z).Magnitude

    targetFov = (speed > 1 and humanoid and humanoid.MoveDirection.Magnitude > 0)
        and 80 or Config.initialFov

    currentFovChange += (targetFov - currentFovChange) * 0.02
    Camera.FieldOfView = currentFovChange
end

-- 🔦 Camera collision handling
local function handleRaycast(desiredCFrame)
    local clipCorrection = 0.2
    local rayStart = Root.Position + Vector3.new(0, currentOffset.Y, 0)
    local rayEnd = (desiredCFrame * CFrame.new(0, 0, clipCorrection)).Position
    local direction = rayEnd - rayStart

    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = {Character}
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist

    local result = workspace:Raycast(rayStart, direction, rayParams)
    if result then
        return CFrame.new(result.Position) * (desiredCFrame - desiredCFrame.Position) * CFrame.new(0, 0, -clipCorrection)
    else
        return desiredCFrame
    end
end

-- 🧠 Main camera update function
local function updateCamera(deltaTime)
    moveX += (targetX - moveX) * Config.smoothness
    moveY += (targetY - moveY) * Config.smoothness

    updateHeadBob(deltaTime)
    updateBreath()
    updateZoom()

    currentOffset = currentOffset:Lerp(targetOffset, Config.transitionSpeed)
    local camPos = Root.Position
    local cam = CFrame.new(camPos) * CFrame.Angles(0, moveX, 0) * CFrame.Angles(moveY, 0, 0)
    cam *= CFrame.new(currentOffset + bobOffset + Vector3.new(0, breathOffset, 0))

    local blurAmount = math.abs((targetOffset - currentOffset).Magnitude) * Config.blurIntensity
    blurEffect.Size = math.min(blurAmount, 24)

    Camera.CFrame = handleRaycast(cam)
end

-- 🚀 Initialization
Camera.CameraType = Enum.CameraType.Scriptable
toggleMouseLock()
RunService.RenderStepped:Connect(updateCamera)
